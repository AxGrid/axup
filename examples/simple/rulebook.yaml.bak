name: simple-demo

vars:
  app_name: simple-demo
  greeting: "hello from deploy"
  mysql_port: 3306
  hosts:
    - api-1
    - api-2

bootstrap:
  - name: ensure target dir exists
    command: "mkdir -p /opt/simple-demo"

  - name: copy banner
    copy:
      src: files/banner.txt
      dst: /opt/simple-demo/banner.txt
      mode: "0644"

  - name: render greeting config
    template:
      src: templates/greeting.conf.tmpl
      dst: /opt/simple-demo/greeting.conf
      mode: "0640"

  - name: announce update
    command: "echo greeting.conf changed; cat /opt/simple-demo/greeting.conf"
    when_changed:
      - /opt/simple-demo/greeting.conf

deploy:
  - name: ping
    command: "echo deploying {{ .app_name }} (this is on the CLI side, just a static command)"
